{
  "name": "honey-loyalty",
  "version": "0.1.0",
  "private": true,
  "description": "Honey Flowers loyalty program (Telegram Mini App): rules engine, service layer, Cloudflare Worker + D1",
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/core",
    "packages/service",
    "apps/api",
    "apps/worker",
    "apps/miniapp"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @honey/worker",
    "dev:api": "npm run build -w @honey/core && npm run build -w @honey/service && npm run dev -w @honey/api",
    "deploy": "npm run deploy -w @honey/worker",
    "db:migrate:remote": "npm run db:migrate:remote -w @honey/worker"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "4.1.11"
  }
}
