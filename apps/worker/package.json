{
  "name": "@honey/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker: Telegram Mini App static files + JSON API + bot webhook + daily cron, on D1",
  "type": "module",
  "scripts": {
    "ensure-assets": "node scripts/ensure-assets.mjs",
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "npm run ensure-assets && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "dev": "npm run ensure-assets && npm run db:migrate:local && wrangler dev --local",
    "deploy": "npm run ensure-assets && wrangler deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@honey/contracts": "0.1.0",
    "@honey/core": "0.1.0",
    "@honey/service": "0.1.0",
    "grammy": "1.46.0",
    "hono": "4.13.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261001.1",
    "wrangler": "4.147.0"
  }
}
